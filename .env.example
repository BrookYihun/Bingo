# Copy to prod.env (master) and dev.env (develop), then set values.
# Deploy: docker compose --env-file prod.env up -d  or  --env-file dev.env
# DB and Redis run on another server – set their host/port/credentials here.

# Required – PostgreSQL (external server)
DJANGO_SECRET_KEY=your-secret-key-here
DB_HOST=your-db-server.example.com
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Required – Redis (external server)
REDIS_HOST=your-redis-server.example.com
REDIS_PORT=6379

# Ports – set per profile (e.g. dev=8000, staging=8080, prod=80)
APP_PORT=8000
WS_PORT=9000

# Optional (defaults shown)
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000

# Sentry (leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SAMPLE_RATE=1.0

# OTP (Afromessage)
OTP_PROVIDER_API_URL=https://api.afromessage.com/api
OTP_PROVIDER_API_KEY=
OTP_EXPIRY_TIME=300
OTP_SENDER_NAME=Dallol Games
OTP_MESSAGE_PREFIX=Wellcome to Dallol Games
OTP_MESSAGE_POSTFIX=

# Telegram
TELEGRAM_BOT_TOKEN=

# DB connection pool (optional)
DB_CONN_MAX_AGE=60
